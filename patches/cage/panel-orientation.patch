+static bool
+is_internal_panel(const char *name)
+{
+	if (!name) {
+		return false;
+	}
+	return strncmp(name, "eDP", 3) == 0 ||
+	       strncmp(name, "DSI", 3) == 0 ||
+	       strncmp(name, "LVDS", 4) == 0 ||
+	       strncmp(name, "DPI", 3) == 0;
+}
+
+static bool
+parse_panel_orientation(const char *val, enum wl_output_transform *out)
+{
+	if (!val || !*val) {
+		return false;
+	}
+	if (strcmp(val, "normal") == 0 || strcmp(val, "0") == 0) {
+		*out = WL_OUTPUT_TRANSFORM_NORMAL;
+		return true;
+	}
+	if (strcmp(val, "90") == 0 || strcmp(val, "left_side_up") == 0) {
+		*out = WL_OUTPUT_TRANSFORM_90;
+		return true;
+	}
+	if (strcmp(val, "180") == 0 || strcmp(val, "upside_down") == 0) {
+		*out = WL_OUTPUT_TRANSFORM_180;
+		return true;
+	}
+	if (strcmp(val, "270") == 0 || strcmp(val, "right_side_up") == 0) {
+		*out = WL_OUTPUT_TRANSFORM_270;
+		return true;
+	}
+	return false;
+}
+
+static bool
+resolve_output_orientation(const char *output_name, enum wl_output_transform *out)
+{
+	if (!output_name || !*output_name) {
+		return false;
+	}
+
+	const char *env_orient = getenv("EXTRA_LIFE_PANEL_ORIENTATION");
+	const char *primary_output = getenv("EXTRA_LIFE_PRIMARY_OUTPUT");
+	const char *secondary_output = getenv("EXTRA_LIFE_SECONDARY_OUTPUT");
+	const char *secondary_orient = getenv("EXTRA_LIFE_SECONDARY_PANEL_ORIENTATION");
+
+	if (env_orient && (strchr(env_orient, ':') != NULL || strchr(env_orient, '=') != NULL)) {
+		char *copy = strdup(env_orient);
+		if (copy) {
+			char *saveptr = NULL;
+			for (char *token = strtok_r(copy, ",;", &saveptr); token != NULL;
+			     token = strtok_r(NULL, ",;", &saveptr)) {
+				char *sep = strchr(token, ':');
+				if (!sep) {
+					sep = strchr(token, '=');
+				}
+				if (!sep) {
+					continue;
+				}
+				*sep = '\0';
+				const char *key = token;
+				const char *val = sep + 1;
+				if (strcmp(key, output_name) == 0 && parse_panel_orientation(val, out)) {
+					free(copy);
+					return true;
+				}
+			}
+			free(copy);
+		}
+		return false;
+	}
+
+	if (secondary_output && *secondary_output && strcmp(output_name, secondary_output) == 0) {
+		if (secondary_orient && *secondary_orient) {
+			return parse_panel_orientation(secondary_orient, out);
+		}
+		return false;
+	}
+
+	if (primary_output && *primary_output && strcmp(output_name, primary_output) == 0) {
+		if (env_orient && *env_orient) {
+			return parse_panel_orientation(env_orient, out);
+		}
+		return false;
+	}
+
+	if (env_orient && *env_orient && is_internal_panel(output_name)) {
+		if (!secondary_output || !*secondary_output || strcmp(output_name, secondary_output) != 0) {
+			return parse_panel_orientation(env_orient, out);
+		}
+	}
+
+	return false;
+}
