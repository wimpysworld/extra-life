+func isGenericGamepadName(name string) bool {
+	lower := strings.ToLower(name)
+	for _, token := range []string{
+		"x-box",
+		"xbox",
+		"wolverine",
+		"razer",
+		"inputplumber",
+		"retrogame_joypad",
+		"rocknix-joypad",
+		"odroidgo",
+		"anbernic",
+		"opensimhardware",
+		"gamepad",
+		"joypad",
+		"controller",
+	} {
+		if strings.Contains(lower, token) {
+			return true
+		}
+	}
+	return false
+}
+
+func ensureGamepadMapping(joy glfw.Joystick) bool {
+	if !joy.Present() {
+		return false
+	}
+	if joy.IsGamepad() {
+		return true
+	}
+	guid := joy.GetGUID()
+	name := joy.GetName()
+	if len(guid) != 32 || !isGenericGamepadName(name) {
+		return false
+	}
+	safeName := strings.ReplaceAll(name, ",", " ")
+	glfw.UpdateGamepadMappings(fmt.Sprintf("%s,%s,%s\n", guid, safeName, defaultLinuxGamepadMapping))
+	return joy.IsGamepad()
+}
