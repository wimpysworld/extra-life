+func detectArch() string {
+	if d := os.Getenv("EXTRA_LIFE_DEVICE"); d != "" {
+		return d
+	}
+	if a := os.Getenv("LIBREELEC_ARCH"); a != "" {
+		return a
+	}
+	return readOSReleaseKey("EXTRA_LIFE_DEVICE", "LIBREELEC_ARCH", "VARIANT_ID", "IMAGE_ID")
+}
+
+func detectVersion() string {
+	if v := os.Getenv("VERSION"); v != "" {
+		return strings.TrimPrefix(v, "v")
+	}
+	return strings.TrimPrefix(readOSReleaseKey("EXTRA_LIFE_VERSION", "VERSION_ID", "VERSION"), "v")
+}
+
+func readOSReleaseKey(keys ...string) string {
+	f, err := os.Open("/etc/os-release")
+	if err != nil {
+		return ""
+	}
+	defer f.Close()
+	vals := map[string]string{}
+	sc := bufio.NewScanner(f)
+	for sc.Scan() {
+		k, v, ok := strings.Cut(sc.Text(), "=")
+		if ok {
+			vals[k] = strings.Trim(v, `"'`)
+		}
+	}
+	for _, k := range keys {
+		if v := vals[k]; v != "" {
+			return v
+		}
+	}
+	return ""
+}
+
+func releasesEndpoint() string {
+	if u := os.Getenv("EXTRA_LIFE_UPDATE_URL"); u != "" {
+		return u
+	}
+	return defaultReleasesURL
 }
 
